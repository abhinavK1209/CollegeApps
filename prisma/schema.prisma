// Sequence — admissions operating system
// See docs/02-DATA-MODEL.md for the design rules behind this schema.
//
// Principles enforced here:
//   1. Reference data (College*Template) is global and cycle-versioned; user rows
//      copy from it and record provenance, so seed updates never clobber overrides.
//   2. Everything derived carries `origin`, `sourceTemplateId`, and `confidence`.
//   3. Two-phase completion: requirements track submittedAt AND confirmedReceivedAt.
//      Submission is not receipt — that gap is where applications actually fail.
//   4. Money is integer cents. Never floats.
//   5. Deadlines carry an IANA timezone: "Jan 1, 11:59pm" means the college's midnight.
//   6. Every user-owned row is userId-scoped even though the app is single-user today,
//      so authentication drops in later with no migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations cannot run through a connection pooler. On Vercel this is the
  // Neon integration's DATABASE_URL_UNPOOLED; locally it mirrors DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

