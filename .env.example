# Copy to .env.local for local development.
#
# LOCAL: `pnpm db:up` starts a Postgres matching the defaults below.
# DEPLOYED: set these in Vercel → Settings → Environment Variables.

# Neon gives you two connection strings. Prisma needs both:
#   DATABASE_URL  → the POOLED string (has "-pooler" in the host). Used at runtime.
#   DIRECT_URL    → the DIRECT string (no "-pooler"). Used for migrations,
#                   which cannot run over a connection pooler.
DATABASE_URL="postgresql://sequence:sequence@localhost:5432/sequence?schema=public"
DIRECT_URL="postgresql://sequence:sequence@localhost:5432/sequence?schema=public"

# Optional. The college seed falls back to the committed snapshot at
# prisma/seed/data/colleges.json when this is unset, so seeding works offline.
# Free key: https://api.data.gov/signup/
COLLEGE_SCORECARD_API_KEY=""
