# Copy to .env.local and adjust as needed.
# `pnpm db:up` starts a Postgres matching the default below.

DATABASE_URL="postgresql://sequence:sequence@localhost:5432/sequence?schema=public"

# Optional. The seed falls back to the committed snapshot in
# prisma/seed/data/colleges.json when this is unset, so seeding works offline.
# Free key: https://api.data.gov/signup/
COLLEGE_SCORECARD_API_KEY=""
