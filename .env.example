# Copy to .env for local development.
#
# LOCAL:    `pnpm db:up` starts a Postgres matching the defaults below.
# DEPLOYED: Vercel's Neon integration creates both of these automatically.
#
# Prisma needs two connection strings:
#   DATABASE_URL          → POOLED   (host contains "-pooler"). Used for queries.
#   DATABASE_URL_UNPOOLED → DIRECT   (no "-pooler"). Used for migrations, which
#                                     cannot run through a connection pooler.
#
# Locally there is no pooler, so both point at the same database.
DATABASE_URL="postgresql://sequence:sequence@localhost:5432/sequence?schema=public"
DATABASE_URL_UNPOOLED="postgresql://sequence:sequence@localhost:5432/sequence?schema=public"

# Needed only by `pnpm db:import:scorecard`, which fills in real admit rates,
# test-score ranges, cost, and enrollment from the U.S. Department of Education.
# Without it the app still runs; colleges just show "—" for those figures.
# Free key, takes a minute: https://api.data.gov/signup/
COLLEGE_SCORECARD_API_KEY=""
